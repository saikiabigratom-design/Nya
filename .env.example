# ==============================================================================
# ঞ (Nya) — Vocal for Local Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   copy .env.example .env
#
# DO NOT COMMIT REAL SECRETS OR KEYS TO VERSION CONTROL.
# ==============================================================================

# Server & Runtime Configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Frontend App URL (for CORS and CSRF protection)
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database Configuration
# Default for zero-config native Windows dev: SQLite database
DATABASE_URL=sqlite+aiosqlite:///./nya_search.db
# For production PostgreSQL / Docker:
# DATABASE_URL=postgresql+asyncpg://nya_user:nya_password@localhost:5432/nya_search

# Search Engine & Ingestion Limits
SEARCH_PAGE_SIZE=10
SEARCH_MAX_QUERY_LENGTH=250
SEARCH_TIMEOUT_SECONDS=2.5

# Privacy & Logging Settings
# STRICT PRIVACY: Do not store raw queries or build advertising profiles
ENABLE_RAW_QUERY_LOGGING=false
ENABLE_SEARCH_HISTORY=false
SEARCH_HISTORY_RETENTION_DAYS=30

# Grounded AI Provider Configuration
# Supported providers: gemini, openai, ollama, mock (for offline/testing)
AI_PROVIDER=mock
AI_MODEL_NAME=gemini-1.5-flash
AI_API_KEY=
# Hard monthly spending cap in USD / INR equivalent (stops AI calls when exceeded)
AI_MONTHLY_BUDGET_USD=10.0
AI_MONTHLY_USAGE_USD=0.0
AI_TIMEOUT_SECONDS=15.0
AI_MAX_EVIDENCE_DOCS=5
AI_MIN_GROUNDING_CONFIDENCE=0.7

# Ingestion / Crawl Policy
CRAWLER_USER_AGENT=NyaSearchBot/1.0 (+https://nya-search.org/bot; bot@nya-search.org)
CRAWLER_RESPECT_ROBOTS_TXT=true
CRAWLER_DEFAULT_RATE_LIMIT_DELAY=1.5
CRAWLER_MAX_CONCURRENT_REQUESTS=2
CRAWLER_TIMEOUT_SECONDS=10.0
